# Google OAuth Client ID for admin authorization.
# Create one in Google Cloud Console (APIs & Services > Credentials > OAuth client ID).
# Authorized JavaScript origin must include your site URL (e.g. http://localhost:3000).
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# (Optional) Comma-separated list of admin email addresses allowed to sign in.
# If left empty, any Google account that signs in is treated as admin.
# Example: VITE_ADMIN_EMAILS="admin@example.com,teacher@example.com"
VITE_ADMIN_EMAILS=""
